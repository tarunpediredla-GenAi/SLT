# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API Key for interactive land parcel maps.
# Automatically provisioned via Google Maps Demo Key or custom BYOK key in AI Studio Secrets.
VITE_GOOGLE_MAPS_API_KEY=""

# ADMIN_BOOTSTRAP_EMAIL: Authorized administrator email for server-side role verification.
ADMIN_BOOTSTRAP_EMAIL="tarunpediredla9966@gmail.com"
